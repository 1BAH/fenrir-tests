#! /usr/bin/env sh

tmp_dir=$(loki -c 'eval' 'echo $FENRIR_TMP_DIR')

docker network create demo-net
docker run -d --net demo-net --name qwerty registry.gitlab.com/ygdrasil/progtech/tech-tasks/http
echo "qwerty" >> "${tmp_dir}/env.conts"

cont="${tmp_dir}/env"
docker network connect demo-net "$(cat "$cont")"


