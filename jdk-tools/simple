#! /usr/bin/env loki

cd simple || exit $?

lokiw -e ./build.sh

lokiw -e ./run.sh
loki-assert-out ""

lokiw ./run.sh qwerty
loki-assert-neq 0 $?

lokiw ./run.sh "12 34"
loki-assert-neq 0 $?

lokiw -e ./run.sh 10 50 40 20 30
loki-assert-out "$(cat <<- OUT
Gancia
Smirnoff
Gancia
OUT
)"

loki-points +5
