#! /usr/bin/env loki

loki-set-log-prefix "DCKR: "

function verify_script {
    local filename=$1
    if ! [ -x "$filename" ]; then
        loki-log err "File '$filename' does not exist or is not executable!"
        exit 8
    fi
}

function run_client {
    if [ -n "$newgrp" ]; then
    	sg reckod /usr/bin/client
    else
    	/usr/bin/client
    fi
}

verify_script "setup.sh"
verify_script "teardown.sh"

##################################################################################

loki-log info "Running setup.sh.."
echo breach | lokiw -e sudo -S ./setup.sh

loki-prog "Testing /var/run/reckod.sock.."

if ! [ -S /var/run/reckod.sock ]; then
	loki-log fail "File was not found!"
fi

if grep 'reckod' /etc/group | grep -q "$(whoami)"; then
	newgrp=1
fi

loki-gorp

loki-prog "Testing server.."

loki-log info "User info"
loki-log info "name: <$(whoami)>"
loki-log info "groups: <$(grep 'reckod' /etc/group | grep "$(whoami)" | cut -f1 -d":" | tr $'\n' ' ')>"

lokiw -e run_client

loki-gorp

loki-log info "Running teardown.sh.."
echo breach | lokiw -e sudo -S ./teardown.sh

loki-prog "Testing server.."

lokiw run_client
loki-assert-neq 0 "$?" "Server must be down!"

loki-gorp

loki-points +25
