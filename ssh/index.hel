[ "${FENV}" = "LÆVATEINN" ] || {
cat <<- OUT > /dev/stderr
${BOLD}${RED}
Invalid HEL format!
Expected <LÆVATEINN>, got <${FENV}> instead!
${ENDC}
OUT
exit 222
}
scripts=(
    "env.down"
    "env.up"
    "part-1"
    "part-2"
    "part-2.enter"
    "part-3"
    ".enter"
)
cfgs=(
)
image="ghcr.io/devtools-course/task-ssh-client:latest"
inline=0
inhost=0
blocking=0
