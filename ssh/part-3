#! /usr/bin/env loki

loki-set-log-prefix "SSH-3: "

if ! [ -f "config" ]; then
    loki-log err "Cannot find file <config>"
    exit 13
fi

#################################################################################################
loki-prog "Installing config.."

cp "config" "/home/fikus/.ssh/config"
chmod 600 "/home/fikus/.ssh/config"

loki-gorp

#######################################################################################
loki-prog "Testing the SSH connection.."

function ping {
    url=$1
    lokiw -e ssh "fikus@$url" "echo Guten Tag!"
    loki-assert-out "Guten Tag!"
}

########
loki-prog "Deutschland"

ping "gitlab.de"
ping "www.google.de"

loki-gorp
#####
loki-prog "Oesterreich"

ping "gitlab.at"
ping "www.google.at"

loki-gorp
#####
loki-prog "Schweiz"

ping "gitlab.ch"
ping "www.google.ch"

loki-gorp
########
loki-prog "Frankreich"
lokiw ssh "fikus@gitlab.fr" "echo Guten Tag!"
loki-assert-neq 0 $?
loki-gorp
########

loki-gorp

loki-points +15
