#! /usr/bin/env loki

set -e

docker network create ssh-net
fenrir-cont-run -e "LOKI_VERBOSE" -v fenrir-shared:/home/fikus -d --net ssh-net --name server ghcr.io/devtools-course/task-ssh:latest

fenrir-cont-run -e "LOKI_VERBOSE" -d --net ssh-net --name deutschland ghcr.io/devtools-course/task-ssh:latest
fenrir-cont-run -e "LOKI_VERBOSE" -d --net ssh-net --name oesterreich ghcr.io/devtools-course/task-ssh:latest
fenrir-cont-run -e "LOKI_VERBOSE" -d --net ssh-net --name schweiz     ghcr.io/devtools-course/task-ssh:latest

docker network connect ssh-net "$(fenrir-main-cont)" # client


voldir=$(fenrir-tmp -d)

mkdir -p "${voldir}"/{cacti,from}

msg="Velociraptor $RANDOM"

cat <<- SCRIPT > "$voldir/cacti/run.me"
#! /bin/bash

echo ${msg} > \$(dirname "\$(realpath "\$0")")/t.rex
SCRIPT

echo "${msg}" > "$voldir/correct"


mkdir -p "$voldir/from/otter/beaver"

cat <<- SCRIPT > "$voldir/from/email.addr"
Velociraptor $RANDOM
SCRIPT

cat <<- SCRIPT > "$voldir/from/otter/email.addr"
Velociraptor $RANDOM
SCRIPT

cat <<- SCRIPT > "$voldir/from/otter/beaver/email.addr"
Velociraptor $RANDOM
SCRIPT


docker cp "$voldir/cacti" server:/home/fikus
docker cp "$voldir/from" server:/home/fikus
docker cp "$voldir/correct" server:/home/fikus
docker exec server chown -R fikus /home/fikus

keys=$(fenrir-tmp -d)

declare -A data=(
    [deutschland]="allemand"
    [oesterreich]="autriche"
    [schweiz]="suisse"
)

docker exec "$(fenrir-main-cont)" mkdir /home/fikus/.ssh

for server in "${!data[@]}"; do
    pays=${data["$server"]}

    ssh-keygen -q -t ed25519 -N '' -f "${keys}/${pays}" <<< 'y'
    docker cp "${keys}/${pays}" "$(fenrir-main-cont):/home/fikus/.ssh/${pays}"

    docker exec "$server" mkdir /home/fikus/.ssh
    docker exec "$server" bash -c "echo '$(< "$keys/${pays}.pub")' >> /home/fikus/.ssh/authorized_keys"
    docker exec "$server" chmod 600 /home/fikus/.ssh/authorized_keys
    docker exec "$server" chown -R fikus:fikus /home/fikus/.ssh
done

docker exec "$(fenrir-main-cont)" bash -c "chmod 600 /home/fikus/.ssh/*"
docker exec "$(fenrir-main-cont)" chown -R fikus:fikus /home/fikus/.ssh
