#! /usr/bin/env bash

set -e

docker network create http-net
fenrir-cont-run -e "LOKI_VERBOSE" -d --net http-net -P --name server ghcr.io/devtools-course/task-http:latest

docker network connect http-net "$(fenrir-main-cont)" # client

port=$(docker inspect --format='{{range $p, $conf := .NetworkSettings.Ports}} {{(index $conf 0).HostPort}} {{end}}' "server" | tr -d ' ')
export DT_HOST="http://localhost:${port}"

loki-log info "Server is running on '${DT_HOST}'"

