#! /usr/bin/env loki

loki-set-log-prefix "SERV: "

function destroy {
	if [[ -v pid ]]; then
		kill -9 $pid &> /dev/null
	fi
}

export LOKI_ASSERT_CB="destroy"
loki-log warn "Do not use Ctrl+C until the testcase is finished!"

lokiw -e cd services

out=$(fenrir-tmp -d)

loki-prog "Running build.sh.."

lokiw -e ./build.sh "$out"

lokiw -u "find . -type f -not -name \"*.iml\" | wc -l | tr -d \"$IFS\""
loki-assert-out 18 "You have not removed build dirs"

loki-gorp
loki-prog "Testing jars.."

java -p "$PWD/lib:$out" -m dt.jpms.apiary &
pid=$!

sleep 1s

lokiw ps -p $pid
loki-assert-eq 0 $? "Failed to start server"

lokiw -e curl -X GET http://localhost:8888/north -H 'Content-Type: application/json' -d '{"mesi":"Fry"}'
loki-assert-out '{"message":"Tere, Fry!"}'

lokiw -e curl -X GET http://localhost:8888/south -H 'Content-Type: application/json' -d '{"bal":"Fry"}'
loki-assert-out '{"message":"Merhaba, Fry!"}'

kill -9 $pid


java -p "$PWD/lib:$out/core.jar:$out/apiary.jar" -m dt.jpms.apiary &
pid=$!

sleep 1s

lokiw ps -p $pid
loki-assert-eq 0 $? "Failed to start server"

lokiw -e curl -X GET http://localhost:8888/north -H 'Content-Type: application/json' -d '{"mesi":"Fry"}'
loki-assert-out '<h1>404 Not Found</h1>No context found for request'

lokiw -e curl -X GET http://localhost:8888/south -H 'Content-Type: application/json' -d '{"bal":"Fry"}'
loki-assert-out '<h1>404 Not Found</h1>No context found for request'

kill -9 $pid

loki-gorp

loki-points +30
