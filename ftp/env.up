#! /usr/bin/env loki

set -e

export USER="tom"
export PASSWORD="lizard"

docker network create ftp-net
fenrir-cont-run -e "LOKI_VERBOSE" -e "PUBLIC_IP=192.168.0.1" -e "FTP_PASS=$PASSWORD" -e "FTP_USER=$USER" \
 			-d --net ftp-net \
 			--name server garethflowers/ftp-server:latest

docker network connect ftp-net "$(fenrir-main-cont)" # client

voldir=$(fenrir-tmp -d)
mkdir -p "$voldir/kotlin"

value="Running from script: $RANDOM"
echo "echo '$value'" > "$voldir/kotlin/groovy.sh"

docker exec server mkdir -p "/home/$USER"
docker cp "$voldir" "server:/home/$USER/java"
docker cp "$voldir/kotlin/groovy.sh" "$(fenrir-main-cont):/tmp/test.correct"

sleep 2s
loki-log info "Server is running"
