#! /usr/bin/env loki

loki-set-log-prefix "FTP-2: "

filename="part-2.sh"
if ! [ -x "$filename" ]; then
    loki-log err "File '$filename' does not exist or is not executable!"
    exit 8
fi

#################################################################################################

loki-log info "Running part-2.sh.."

lokiw -e ./part-2.sh "/tmp/fenrir-shared/java/kotlin/groovy.sh"

if ! [ -f "/tmp/fenrir-shared/sieben/ein/zwei.drei" ]; then
	loki-log fail "File was not uploaded"
fi

loki-assert-feq "/tmp/fenrir-shared/java/kotlin/groovy.sh" "/tmp/fenrir-shared/sieben/ein/zwei.drei"

loki-points +5
