#! /usr/bin/env loki

if docker exec "$(fenrir-main-cont)" test -f "/home/$USER/sieben/ein/zwei.drei"; then
	loki-prog "Validate part-2"

	if ! docker exec server test -f "/home/$USER/sieben/ein/zwei.drei"; then
		loki-log err "File <sieben/ein/zwei.drei> was not found"
	fi

	content=$(docker exec server cat "/home/$USER/sieben/ein/zwei.drei")
	if (( $? != 0 )) || [ "$content" != "$value" ]; then
		loki-log err "Invalid file content"
	else
		loki-points +5
	fi

	loki-gorp
fi

docker rm -f server

for i in `docker network inspect -f '{{range .Containers}}{{.Name}} {{end}}' ftp-net`; do
    docker network disconnect -f ftp-net "$i"
done

docker network rm -f ftp-net
