#! /usr/bin/env loki

loki-set-log-prefix "HK: "


function mkfile {
	cat <<- 'EOF' > "$1"
		#! /usr/bin/env bash
		echo 'HI'
	EOF
}

function get_mode {
    read -r -a data < <(git ls-tree HEAD "$1")
    echo "${data[0]}"
}


if ! change-branch "hooks"; then
    loki-log err "Terminating.."
    exit 1
fi

loki-prog "Installing script.."

if ! [ -x "install" ]; then
    loki-log err "Script 'install' was not found!"
    exit 1
fi

lokiw -e ./install

loki-gorp

#################################
loki-prog "No .sh files"

loki-log info "Creating <100644 qwe> & <100755 qwe1>.."
mkfile "qwe"
chmod +x qwe
mkfile "qwe1"

loki-log info "Commiting changes.."
lokiw -e git add .
lokiw -e git commit -m "msg"

loki-assert-eq 100755 "$(get_mode "qwe")"  "Invalid file mode (qwe)"
loki-assert-eq 100644 "$(get_mode "qwe1")" "Invalid file mode (qwe1)"

lokiw -e git reset --hard HEAD^
loki-gorp
#################################
loki-prog "Unchmoded .sh files"

loki-log info "Creating <100644 qwe.sh> & <100755 qwe1.sh>.."
mkfile "qwe.sh"
chmod +x qwe.sh
mkfile "qwe1.sh"

loki-log info "Commiting changes.."
lokiw -e git add .
lokiw -e git commit -m "msg"

loki-assert-eq 100755 "$(get_mode "qwe.sh")"  "Invalid file mode (qwe.sh)"
loki-assert-eq 100755 "$(get_mode "qwe1.sh")" "Invalid file mode (qwe1.sh)"

lokiw -e git reset --hard HEAD^
loki-gorp
#################################
loki-prog "Already existing unchmoded .sh files"

loki-log info "Creating <100644 qwe.sh>.."
mkfile "qwe.sh"

loki-log info "Commiting changes ignoring the hooks.."
lokiw -e git add .
lokiw -e -u 'git commit --no-verify -m "msg"'

loki-log info "Creating <100644 qwe1.sh>.."
mkfile "qwe1.sh"

loki-log info "Commiting changes.."

lokiw -e git add .
lokiw -e git commit -m "msg"

loki-assert-eq 100644 "$(get_mode "qwe.sh")"  "Invalid file mode (qwe.sh)"
loki-assert-eq 100755 "$(get_mode "qwe1.sh")" "Invalid file mode (qwe1.sh)"

lokiw -e git reset --hard HEAD^
loki-gorp
#################################

loki-points +10
