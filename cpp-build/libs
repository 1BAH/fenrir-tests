#! /usr/bin/env loki


lokiw -e -u "find lib -type f -and \( -not -name '*.sh' \) | wc -l"
loki-assert-out 5

lokiw -e -u "find lib -type f -and \( -name '*.hh' -or -name '*.cc' \) | sort "
loki-assert-out "$(cat <<- OUT
lib/moduleA/iterator.cc
lib/moduleA/iterator.hh
lib/moduleB/array.cc
lib/moduleB/array.hh
lib/use.cc
OUT
)"

lokiw -e cd lib

verify_script "multi.sh"

out=$(fenrir-tmp -d)

lokiw -e ./multi.sh "$out"

lokiw -e find "$out" -type f -maxdepth 1
loki-assert-out "$out/run"

lokiw -e file "$out/lib/libmoda.a"
loki-assert-rout ".* ar archive.*"

lokiw -e file "$out/lib/libmodb.so"
loki-assert-rout ".* shared object.*"


lokiw "$out/run"
loki-assert-neq 0 $?

LD_LIBRARY_PATH="$out/lib" lokiw -e "$out/run"
loki-assert-out "3
2
1"

loki-points +5
