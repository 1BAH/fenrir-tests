#! /usr/bin/env loki

loki-set-log-prefix "SB-0: "

filename="part-0.sh"

if ! [ -x "$filename" ]; then
    loki-log err "File '$filename' does not exist or is not executable!"
    exit 8
fi

#################################################################################################

lokiw -e ./"$filename" "qwe.sh"
loki-assert-out "sh"

lokiw -e ./"$filename" "gitignore"
loki-assert-out ""

lokiw -e ./"$filename" "qwe.tar.gz"
loki-assert-out "tar.gz"

lokiw -e ./"$filename" "qwe.tbz2"
loki-assert-out "tbz2"

lokiw -e ./"$filename" ".gitignore"
loki-assert-out ""

lokiw -e ./"$filename" ".prettierrc.json"
loki-assert-out "json"

loki-points +10
