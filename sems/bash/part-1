#! /usr/bin/env loki

loki-set-log-prefix "SB-1: "

filename="part-1.sh"

if ! [ -x "$filename" ]; then
    loki-log err "File '$filename' does not exist or is not executable!"
    exit 8
fi

#################################################################################################

lokiw -e -u "echo 0 | ./$filename"
loki-assert-out "1"

lokiw -e -u "echo 1 | ./$filename"
loki-assert-out "1"

lokiw -e -u "echo 2 | ./$filename"
loki-assert-out "2"

lokiw -e -u "echo 5 | ./$filename"
loki-assert-out "120"

loki-points +10
