#! /usr/bin/env loki

loki-set-log-prefix "SB-4: "

filename="part-4.sh"

if ! [ -x "$filename" ]; then
    loki-log err "File '$filename' does not exist or is not executable!"
    exit 8
fi

#################################################################################################

empty=$(fenrir-tmp -d)

lokiw -e ./"$filename" "$empty"
loki-assert-out ""

plain=$(fenrir-tmp -d)
touch "${plain}/1.txt"
touch "${plain}/2.txt"
touch "${plain}/1.tt"
touch "${plain}/1.tx"

lokiw -e ./"$filename" "$plain"
loki-assert-out "$(cat <<- EOF
tt   1
tx   1
txt  2
EOF
)"

tricky_ext=$(fenrir-tmp -d)
touch "${plain}/1.tar.gz"
touch "${plain}/2.tar.bz2"
touch "${plain}/1.gz.tar"
touch "${plain}/2.tar.gz"

lokiw -e ./"$filename" "$tricky_ext"
loki-assert-out "$(cat <<- EOF
gz.tar   1
tar.bz2  1
tar.gz   2
EOF
)"


tricky_names=$(fenrir-tmp -d)
touch "${plain}/the hehe.o"
touch "${plain}/a.a"
touch "${plain}/.aoaoaoaoa"
touch "${plain}/аоаоаоаоаа.meow"

lokiw -e ./"$filename" "$tricky_names"
loki-assert-out "$(cat <<- EOF
a     1
meow  1
o     1
EOF
)"

loki-points +10
