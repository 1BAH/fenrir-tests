#! /usr/bin/env loki

loki-set-log-prefix "RPM-ALT: "

checkout crows
verify_script "build-rpm.sh"

##################################################################################
pm="dnf"
package="./raven-1.0.0.noarch.rpm"
pts=5

loki-log info "Running build-rpm.sh.."
lokiw -e ./build-rpm.sh

loki-log info "Installing.."
echo breach | lokiw -e sudo -S "$pm" install --disablerepo='*' --cacheonly -y "$package"

loki-prog "Testing alternatives.."

if ! [ -L /etc/alternatives/raven ]; then
	loki-log fail "Alternative <raven> was not found"
	exit 6
fi

lokiw -e readlink "$(type raven | cut -d' ' -f3)"
loki-assert-out "/etc/alternatives/raven"

loki-points +$pts

export LOKI_ASSERT_CB="loki-points -$pts"

loki-prog "Now checking uninstall.."

echo breach | lokiw sudo -S dnf remove -y raven
loki-assert-eq 0 $?

lokiw test -L /etc/alternatives/raven
loki-assert-neq 0 $? "Alternative was not removed!"

loki-gorp
