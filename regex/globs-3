#! /usr/bin/env loki

loki-set-log-prefix "G3: "

shopt -s globstar
loki-log info "Option <globstar> is enabled"

if ! [ -f "answer.properties" ]; then
    loki-log err "File 'answer.properties' does not exist"
    exit 5
fi

loki-assert-eq 3 "$(wc -l answer.properties | sed -E 's|(\S)\s+(\S)|\1 \2|g' | sed -E 's|^\s+(\S)|\1|' | sed -E 's|(\S)\s+|\1|' | cut -d' ' -f1)" "Expected 3 lines in the file"

glob=$(
source "answer.properties"
echo "$task3"
)
loki-assert-eq 0 "$?" "Error when reading the values (glob=<$glob>)"


no_spaces "${root_dir}/${glob}"
soundness "${root_dir}/${glob}"
completeness "${root_dir}/${glob}" "$(( task3_exp + task3_exp_rec ))"

loki-points +4
