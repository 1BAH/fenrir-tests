#! /usr/bin/env loki

set -e

docker exec -u root "$(fenrir-main-cont)" sh -c "echo 'echo \"HI\"' > /usr/bin/jakov"
docker exec -u root "$(fenrir-main-cont)" chmod +x /usr/bin/jakov

docker exec -u root "$(fenrir-main-cont)" chown root:root /usr/bin/sudo
docker exec -u root "$(fenrir-main-cont)" chmod 4755 /usr/bin/sudo
