[ "${FENV}" = "LÆVATEINN" ] || {
cat <<- OUT > /dev/stderr
${BOLD}${RED}
Invalid HEL format!
Expected <LÆVATEINN>, got <${FENV}> instead!
${ENDC}
OUT
exit 222
}
scripts=(
    "binary"
    "install"
    "clean"
    "shared-lib"
    "static-lib"
)

cfgs=()

image="ghcr.io/devtools-course/task-make:latest"
branch="make"
blocking=1
inline=0
inhost=0
