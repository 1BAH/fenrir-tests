#! /usr/bin/env loki

loki-set-log-prefix "INS: "

loki-prog "Installing (testdir).."
testdir=$(fenrir-tmp -d)

lokiw -e make
lokiw make install DESTDIR="${testdir}"
loki-gorp

loki-prog "Testing the libraries"
lokiw -u "readelf -d '${testdir}/lib/libludus.so' | grep SONAME | grep -oE '\[.*\]'"
loki-assert-out "[libludus.so]"

lokiw -e readlink "${testdir}/lib/libludus.so"
loki-assert-out "${testdir}/lib/libludus.so.2"

lokiw -u "readelf -d '${testdir}/lib/libludus.so.1' | grep SONAME | grep -oE '\[.*\]'"
loki-assert-out "[libludus.so]"

loki-gorp

loki-prog "Installing (system).."
lokiw -e make
echo "breach" | lokiw -e sudo -S make install DESTDIR=/usr/local
loki-gorp

loki-prog "Testing the binary"
lokiw -e colosseum
loki-assert-rout "Panem et circenses!"
loki-assert-rout "gladiator mortuus est!"
loki-gorp

loki-prog "Testing the library"
lokiw -e g++ main.cpp -lludus -lgladiator -L lib -I c-lib/include -o bin/colo
lokiw -e ./bin/colo
loki-assert-rout "Panem et circenses!"
loki-assert-rout "gladiator mortuus est!"
loki-gorp

loki-points +15
