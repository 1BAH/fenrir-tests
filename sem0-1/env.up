#! /usr/bin/env sh

set -e

docker network create sem0-net
fenrir-cont-run -d --net sem0-net --name remote ghcr.io/devtools-course/task-http:latest

docker network connect sem0-net "$(fenrir-main-cont)"

docker exec -u root "$(fenrir-main-cont)" sh -c 'echo -e "pass\npass" | passwd'
docker exec -u root "$(fenrir-main-cont)" apk add --no-cache busybox-suid
